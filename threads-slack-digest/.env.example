# --- Threads (Meta) 공식 API ---
# https://developers.facebook.com/docs/threads 에서 발급한 장기 액세스 토큰
THREADS_ACCESS_TOKEN=
# 보통 "me" 로 두면 토큰 소유 계정의 글을 읽습니다. 특정 user id 가 있으면 입력.
THREADS_USER_ID=me

# --- Claude API (요약) ---
ANTHROPIC_API_KEY=
# 요약에 사용할 모델 (기본: claude-sonnet-4-6)
MODEL=claude-sonnet-4-6

# --- Slack ---
# xoxb- 로 시작하는 봇 토큰 (scope: chat:write, files:write)
SLACK_BOT_TOKEN=
# 게시할 채널 ID (예: C0123456789)
SLACK_CHANNEL_ID=
# (선택) 메시지에 표시할 이름/아이콘
SLACK_USERNAME=Threads 다이제스트
SLACK_ICON_EMOJI=:newspaper:

# --- 동작 옵션 ---
# 최근 며칠치 글을 모아 요약할지 (기본 2일)
LOOKBACK_DAYS=2
# 주말 가드/요일 체크를 무시하고 강제로 한 번 실행 (수동 테스트용): true/false
FORCE_RUN=false
